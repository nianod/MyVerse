{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "verseF/src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "verseF/.expo/types/**/*.ts",
    "verseF/expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}